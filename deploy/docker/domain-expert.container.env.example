# Expert Agents domain expert worker: container environment for a PUBLIC
# expert deployment. One served domain, the whole shared corpus by default
# (an empty excludedSources list), multi-query retrieval and reranking on, and
# the attached Google identity of the host instead of a key.
#
# Pass with `docker run --env-file`; render it from a credential broker and
# keep the rendered file out of Git. Every field is documented in
# deploy/systemd/domain-expert.env.example; this file is the shape, not new
# configuration.

# Loopback inside the shared network namespace; never publish the port.
EXPERT_AGENTS_DOMAIN_EXPERT_HOST=127.0.0.1
EXPERT_AGENTS_DOMAIN_EXPERT_PORT=8040
# Writable, non-durable: the worker keeps no customer data. A tmpfs owned by
# uid/gid 10001 is enough.
EXPERT_AGENTS_DOMAIN_EXPERT_DATA_DIR=/var/lib/expert-agents/domain-expert
EXPERT_AGENTS_DATA_DIR=/var/lib/expert-agents/domain-expert
# Bearer the consumer presents. Required; the worker refuses to start without it.
EXPERT_AGENTS_DOMAIN_EXPERT_AUTH_TOKEN=<broker-injected-bearer-token>
# The project that HOSTS the shared corpus, which may differ from the project
# running this container. The attached identity needs retrieval-only access there.
EXPERT_AGENTS_GCP_PROJECT=<project-hosting-the-shared-corpus>
# Vertex location of that corpus (the worker's default is us-central1).
EXPERT_AGENTS_DOMAIN_EXPERT_RAG_LOCATION=us-central1
EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_METADATA_TOKEN=1
# One domain routed to the shared corpus. Replace public-expert with the
# consumer's domain id and the example names with the real shared library
# location and corpus display name. disclosure.excludedSources is the deny
# list: empty serves everything; add {"displayName":"..."} entries to withhold
# named works.
EXPERT_AGENTS_DOMAIN_EXPERT_AGENTS_JSON={"public-expert":{"displayName":"Public Expert","library":{"bucket":"example-shared-library","prefix":"library/v1"},"targetCorpusDisplayName":"example-shared-corpus","retrieval":{"multiQuery":true,"reranker":"rank-service"},"disclosure":{"excludedSources":[]}}}
