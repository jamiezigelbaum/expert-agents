# Copy to page-library.env (mode 0600). Values are secrets: render them with
# the deployment's credential broker, never commit them.
PAGE_LIBRARY_PG_PASSWORD=<generated>
PAGE_LIBRARY_TREE=/var/lib/expert-agents/page-library/<domain>/tree
VOYAGE_API_KEY=<voyage key>
GBRAIN_EMBEDDING_MODEL=voyage:voyage-4
GBRAIN_EMBEDDING_DIMENSIONS=1024
