# Copy to page-library.env (mode 0600) beside compose.yaml. Every value is a
# secret or host choice: render it with the deployment's credential broker,
# never commit it. Generate passwords as hex (openssl rand -hex 24) so they
# sit in database URLs without escaping.
PAGE_LIBRARY_PG_PASSWORD=<generated>
# The worker's serving (read-only) and ingest (row-write) logins.
PAGE_READER_PASSWORD=<generated>
PAGE_WRITER_PASSWORD=<generated>

# Optional. Defaults shown.
# PAGE_LIBRARY_PROJECT=page-library          # a second library (private shelf) uses another name
# PAGE_LIBRARY_PG_BIND=127.0.0.1:5442        # host address of the database port
# PAGE_LIBRARY_WORKER_BIND=127.0.0.1:8041    # host address of the worker port
# PAGE_LIBRARY_WORKER_ENV=worker.env         # the worker's own settings (worker.env.example)
# EXPERT_AGENTS_IMAGE=expert-agents-domain-expert:local
