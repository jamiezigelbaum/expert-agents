# The page-library worker's settings (compose.yaml, profile `worker`). Copy to
# worker.env (mode 0600) and render the secrets from the deployment's
# credential broker. The database URLs are set by compose.yaml; every other
# field is documented in deploy/systemd/domain-expert.env.example.

# Bearer every consumer presents. Required.
EXPERT_AGENTS_DOMAIN_EXPERT_AUTH_TOKEN=<broker-injected-bearer-token>
EXPERT_AGENTS_DOMAIN_EXPERT_VOYAGE_API_KEY=<broker-injected-voyage-key>

# Routes. Several routes may share one library (one sourceId), each with its
# own disclosure: here an owner route reads it unbounded and a public route
# reads the same books under bounds. A route without "root" reads the library
# from the database.
EXPERT_AGENTS_DOMAIN_EXPERT_AGENTS_JSON={"owner-expert":{"library":{"bucket":"example-library","prefix":"v2/books"},"pageLibrary":{"sourceId":"shared-books"}},"public-expert":{"library":{"bucket":"example-library","prefix":"v2/books"},"pageLibrary":{"sourceId":"shared-books"},"disclosure":{"bounds":{"maxQuoteChars":600,"maxQuotesPerSource":2,"maxSourceCoveragePerSession":0.2}}}}

# Google: view_page reads originals, ingest stores them. One of the
# credential forms in domain-expert.env.example; a key file is mounted read-only.
EXPERT_AGENTS_GCP_PROJECT=<project>
# EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_SERVICE_ACCOUNT_JSON=<broker-injected-service-account-json>

# OCR for scans during library_ingest: the model router (docs/page-library.md).
# EXPERT_AGENTS_DOMAIN_EXPERT_OCR_ROUTER_URL=http://<router-host>:<port>/v1
