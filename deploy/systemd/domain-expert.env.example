# Expert Agents domain expert worker environment
# Copy to /etc/expert-agents/domain-expert.env, replace only the values you use,
# keep the destination out of Git, and set it to root:expert-agents mode 0640.

# Core worker
# EXPERT_AGENTS_DOMAIN_EXPERT_HOST=127.0.0.1
# EXPERT_AGENTS_DOMAIN_EXPERT_PORT=8040
# EXPERT_AGENTS_DOMAIN_EXPERT_DATA_DIR=/var/lib/expert-agents/domain-expert
# Credential-handle registry root; defaults to ~/.local/share/expert-agents,
# which is unwritable under this unit's ProtectHome=read-only.
# EXPERT_AGENTS_DATA_DIR=/var/lib/expert-agents/domain-expert
# Optional workspace-root policy map. Gates only the expert_agents_workspace
# file tools, domain_source registry writes, and staged imports (stage_import,
# web_import, notion_import); serving (domain_ask) runs without it. Two lanes
# misread the comment below as attaching to this line — it does not.
# Example: {"expert_agents_workspace":{"path":"/var/lib/expert-agents/domain-expert/workspace","max_write_bytes":104857600,"allow_overwrite":false}}
# EXPERT_AGENTS_DOMAIN_EXPERT_ROOTS_JSON=<json-root-policy-map-or-array>

# REQUIRED for live domain serving; unconfigured domains refuse live work with
# agent_not_configured. Accepts inline JSON or @<absolute-json-file>.
# Governance example: {"governance":{"displayName":"Governance Expert","library":{"bucket":"<shared-library-bucket>","prefix":"<shared-library-prefix>"},"targetCorpusDisplayName":"governance-docs"}}
# EXPERT_AGENTS_DOMAIN_EXPERT_AGENTS_JSON=<inline-json-or-@absolute-json-file>
# Optional factory registration authority; disabled when unset. The worker may
# register new agents only in this existing bucket and prefix subtree. Existing
# deployment routes and corpus names cannot be adopted or overwritten. Approved
# registrations persist under DATA_DIR and load without a service restart.
# Example: {"bucket":"<factory-library-bucket>","prefix":"agents"}
# EXPERT_AGENTS_DOMAIN_EXPERT_REGISTRATION_LIBRARY_JSON=<json-library-location>
# REQUIRED. The worker refuses to start without it. Loopback is not a trust
# boundary: every local process can reach this port, and the tool surface
# includes corpus mutation and rag_corpus delete_file.
# EXPERT_AGENTS_DOMAIN_EXPERT_AUTH_TOKEN=<broker-injected-bearer-token>
# Local development only. Set to 1 to run unauthenticated on loopback when no
# auth token is configured. Never set this on a deployed host.
# EXPERT_AGENTS_DOMAIN_EXPERT_ALLOW_UNAUTHENTICATED=1

# Google managed RAG, generation, transcription, retrieval, and reranking
# Use one Google credential mechanism appropriate to the deployment.
# REQUIRED for live deployments: GCP project hosting the Vertex corpora and
# shared library. Missing or invalid project ids block cloud work before any
# Vertex request; health reports project_not_configured even with credentials.
# EXPERT_AGENTS_GCP_PROJECT=<gcp-project-id>
# Vertex location of the declared corpora, retrieval and generation calls.
# Defaults to us-central1; set it only when the corpora live elsewhere.
# EXPERT_AGENTS_DOMAIN_EXPERT_RAG_LOCATION=<google-cloud-region>
# EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_ACCESS_TOKEN=<broker-injected-access-token>
# EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_SERVICE_ACCOUNT_JSON=<broker-injected-service-account-json>
# EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_SERVICE_ACCOUNT_JSON_FILE=<absolute-path-to-broker-provisioned-json>
# Attached-identity mode for Google Compute Engine (a VM, or a container on
# one): set to 1 and provision no key material; access tokens come from the
# instance metadata server. Consulted only when no access token or
# service-account JSON is configured. Health reports google_credentials
# unreadable until the metadata server actually answers.
# EXPERT_AGENTS_DOMAIN_EXPERT_GOOGLE_METADATA_TOKEN=1
# EXPERT_AGENTS_DOMAIN_EXPERT_GENERATE_MODEL=<google-generation-model>
# EXPERT_AGENTS_DOMAIN_EXPERT_TRANSCRIBE_MODEL=<google-transcription-model>
# EXPERT_AGENTS_DOMAIN_EXPERT_RETRIEVAL_TOP_K=<positive-integer>
# EXPERT_AGENTS_DOMAIN_EXPERT_ANSWER_CONTEXT_LIMIT=<positive-integer>
# EXPERT_AGENTS_DOMAIN_EXPERT_RERANKER=<rank-service-or-llm-or-off>
# EXPERT_AGENTS_DOMAIN_EXPERT_RERANKER_MODEL=<google-reranker-model>
# EXPERT_AGENTS_DOMAIN_EXPERT_MULTI_QUERY=<true-or-false>
# Parser for RAG imports. Unset uses the LLM parser with its default model;
# set a model id to override it, or the literal value default to send no
# parsing config and let Vertex apply its own default parser. The LLM parser
# is sent only for the file types Google documents it supports (PDF and
# images) and bills per parsed page.
# EXPERT_AGENTS_DOMAIN_EXPERT_RAG_PARSER_MODEL=<google-parser-model-or-default>

# Anna's Archive acquisition and import
# Live search needs BASE_URL or SEARCH_URL_TEMPLATE in addition to the API
# key; with only the key placed, search still returns plans, and health
# reports annas_archive: false. With BASE_URL and no SEARCH_URL_TEMPLATE the
# worker drives the site's HTML search page, which is the only search surface
# offered; there is no JSON search API to point a template at.
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_ARCHIVE_API_KEY=<broker-injected-api-key>
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_ARCHIVE_BASE_URL=<https-base-url>
# Set to true only when BASE_URL is a real Anna's Archive origin and the key is
# a paid membership secret key. Downloads then resolve through the member API
# at <base>/dyn/api/fast_download.json, which takes the md5 and the key as
# query parameters and answers with a partner-host download_url; the bytes are
# fetched from that host with no credentials attached. Requires an md5 on the
# import (md5, an md5 annas_archive_id, or an /md5/<hash> record URL), and an
# exhausted download quota fails honestly instead of saving the error envelope.
# Leave unset to keep using DOWNLOAD_URL_TEMPLATE instead.
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_FAST_DOWNLOAD=true
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_SEARCH_URL_TEMPLATE=<search-url-template>
# Optional discovery fallback. Since 2026-09-17 Anna's Archive gates its HTML
# search behind a browser check while the member download API keeps answering.
# When search fails there (any non-2xx or network error), the worker searches
# this Library Genesis origin (libgen.li family, /index.php) without
# credentials and returns the same candidate shape with search.backend
# "libgen_fallback" and a warning; import still resolves each md5 through the
# Anna's Archive fast download. Never used while Anna's Archive search works.
# EXPERT_AGENTS_DOMAIN_EXPERT_LIBGEN_BASE_URL=https://libgen.li
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_DOWNLOAD_URL_TEMPLATE=<download-url-template>
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_IMPORT_GCS_PREFIX=<gs-prefix>
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_MAX_DOWNLOAD_BYTES=<positive-integer>
# Book-scale floor for RAG ingest: a downloaded PDF whose measured page count is
# below this is left on disk and never uploaded or imported (default 60). Only a
# positive measurement blocks — an unparseable or non-PDF artifact is recorded as
# unmeasured and ingests normally. Set 0 to disable the gate; an individual
# import can bypass it deliberately with allow_short_artifact: true.
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_MIN_PDF_PAGES=<non-negative-integer>
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_BOOKS_ROOT=<absolute-books-directory>
# Ingest conversion and verification. Vertex RAG parses PDF/text/Markdown/HTML
# only: an EPUB is converted to Markdown in-process, a DJVU through djvutxt
# (djvulibre) when the binary resolves on PATH, and MOBI/AZW3 are refused.
# After submitting the import the worker polls the Vertex operation at the
# interval below until it settles or the timeout (which also bounds the
# busy-corpus / 429 submission backoff) runs out.
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_DJVUTXT_BIN=djvutxt
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_IMPORT_POLL_INTERVAL_MS=5000
# EXPERT_AGENTS_DOMAIN_EXPERT_ANNAS_IMPORT_POLL_TIMEOUT_MS=600000

# Notion import
# EXPERT_AGENTS_DOMAIN_EXPERT_NOTION_TOKEN=<broker-injected-integration-token>
# EXPERT_AGENTS_DOMAIN_EXPERT_NOTION_VERSION=<notion-api-version>
# EXPERT_AGENTS_DOMAIN_EXPERT_NOTION_MAX_OBJECTS=<positive-integer>

# Content extraction (rag_corpus web_import)
# web_import converts already-fetched HTML in process. YouTube URLs use
# summarize in extraction-only mode (summarize --extract --format md), with a
# credential-stripped subprocess environment. Its HOME and XDG directories are
# private worker-owned paths below EXPERT_AGENTS_DOMAIN_EXPERT_DATA_DIR, so the
# service account's read-only home and unrelated user config are never inherited.
# The same private tree is the subprocess cwd, preventing caller-project .env
# discovery from reloading provider keys removed by the environment filter.
# A fetched PDF is verified from its bytes and may be up to exactly 100,000,000
# bytes; text/default processing retains the 10,000,000-byte limit. Larger
# originals need the documented background page-splitting flow, which is not
# yet implemented.
# summarize is a Node CLI: install
# it system-wide for the service account with `npm i -g @steipete/summarize`
# on a host that has a Node runtime. Without it, YouTube extraction fails with
# summarize_not_installed; ordinary HTML still works. Set this only when the
# binary is not on the unit's PATH; health reports configured.summarize.
# EXPERT_AGENTS_DOMAIN_EXPERT_SUMMARIZE_BIN=<absolute-path-to-summarize>

# Optional host tools
# yt-dlp is no longer invoked by this worker. It remains summarize's media
# dependency for YouTube and audio/video sources, and a path set here is
# forwarded to summarize as YT_DLP_PATH. Leave unset to let summarize resolve
# yt-dlp itself.
# EXPERT_AGENTS_DOMAIN_EXPERT_YTDLP_BIN=<absolute-path-to-yt-dlp>
