[Unit]
Description=Expert Agents domain expert worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=expert-agents
Group=expert-agents
WorkingDirectory=/opt/expert-agents/current
EnvironmentFile=/etc/expert-agents/domain-expert.env
ExecStart=/usr/local/bin/bun /opt/expert-agents/current/packages/runtime/dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/expert-agents/domain-expert

[Install]
WantedBy=multi-user.target
